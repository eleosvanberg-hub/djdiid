# ValueSERP API key — get yours at https://www.valueserp.com
VALUESERP_API_KEY=your_api_key_here

# ── Optional tuning ──────────────────────────────────────────
# Number of result pages to fetch per dork query (default 3, max ~10)
DORKER_PAGES=3

# Seconds to wait between API requests to avoid rate-limiting (default 1.5)
DORKER_DELAY=1.5

# HTTP/HTTPS proxy URL, e.g. http://127.0.0.1:8080 (leave blank to disable)
DORKER_PROXY=

# Google search country code (us, gb, de, fr, …)
DORKER_COUNTRY=us

# Google search language code (en, de, fr, …)
DORKER_LANGUAGE=en

# Safe-search setting (off / medium / high)
DORKER_SAFE=off

# Request timeout in seconds
DORKER_TIMEOUT=30
