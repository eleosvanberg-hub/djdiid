# ValueSERP API key — get yours at https://www.valueserp.com
VALUESERP_API_KEY=your_api_key_here

# ── Optional tuning ──────────────────────────────────────────
# Number of result pages to fetch per dork query (default 3, max ~10)
DORKER_PAGES=3

# Seconds to wait between API requests to avoid rate-limiting (default 1.5)
DORKER_DELAY=1.5

# HTTP/HTTPS proxy URL, e.g. http://127.0.0.1:8080 (leave blank to disable)
DORKER_PROXY=

# Google search country code (us, gb, de, fr, …)
DORKER_COUNTRY=us

# Google search language code (en, de, fr, …)
DORKER_LANGUAGE=en

# Safe-search setting (off / medium / high)
DORKER_SAFE=off

# Request timeout in seconds
DORKER_TIMEOUT=30

# ── Telegram notifications ───────────────────────────────────
# Bot token from @BotFather (e.g. 123456789:AABBcc...)
TG_BOT_TOKEN=

# Your Telegram user ID or group chat ID (get it from @userinfobot)
TG_CHAT_ID=

# Minimum risk score a result must have before it's sent to Telegram (0 = all)
TG_MIN_SCORE=20

# Send exported report files as Telegram documents at the end of each scan (true/false)
TG_SEND_FILES=true
